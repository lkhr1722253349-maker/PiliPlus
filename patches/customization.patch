+import 'dart:io';
+
+import 'package:PiliPlus/plugin/pl_player/models/play_status.dart';
+import 'package:PiliPlus/services/audio_handler.dart';
+import 'package:PiliPlus/utils/storage.dart';
+import 'package:audio_service/audio_service.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:hive_ce/hive.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test(
+    'listening notification exposes previous, next and mode actions',
+    () async {
+      final directory = await Directory.systemTemp.createTemp(
+        'listening-notification-',
+      );
+      Hive.init(directory.path);
+      GStorage.setting = await Hive.openBox('setting');
+      final handler = VideoPlayerServiceHandler()..enableBackgroundPlay = true;
+      handler.setListeningMediaItem(
+        const MediaItem(id: 'listening:test', title: 'song'),
+      );
+      var changes = 0;
+      final calls = <String>[];
+      handler.bindListeningSession(
+        play: () async => calls.add('play'),
+        pause: () async => calls.add('pause'),
+        next: () async => calls.add('next'),
+        previous: () async => calls.add('previous'),
+        seek: (_) async => calls.add('seek'),
+        mode: () => changes++,
+      );
+      handler.onPlay = () async => calls.add('wrong player');
+      handler.onSkipToNext = () => calls.add('wrong next');
+      handler.updateListeningMode('shuffle');
+      handler.onUpdateState(
+        PlayerStatus.playing,
+        false,
+        false,
+        position: Duration.zero,
+        speed: 1,
+        listening: true,
+      );
+      final state = handler.playbackState.value;
+      expect(state.controls.map((e) => e.label), [
+        '上一首',
+        'Pause',
+        '下一首',
+        '随机播放',
+      ]);
+      expect(state.shuffleMode, AudioServiceShuffleMode.all);
+      expect(state.androidCompactActionIndices, [0, 1, 2]);
+      await handler.play();
+      await handler.pause();
+      await handler.skipToNext();
+      await handler.skipToPrevious();
+      await handler.seek(const Duration(seconds: 3));
+      await handler.fastForward();
+      await handler.rewind();
+      expect(calls, [
+        'play',
+        'pause',
+        'next',
+        'previous',
+        'seek',
+        'next',
+        'previous',
+      ]);
+      handler.onUpdateState(
+        PlayerStatus.paused,
+        false,
+        false,
+        position: Duration.zero,
+        speed: 1,
+      );
+      handler.clear();
+      expect(handler.playbackState.value.playing, isTrue);
+      expect(handler.mediaItem.value?.id, 'listening:test');
+      await handler.customAction('listeningMode');
+      expect(changes, 1);
+      handler.clearListeningMediaItem();
+      await handler.customAction('listeningMode');
+      expect(changes, 1);
+      await Hive.close();
+      await directory.delete(recursive: true);
+    },
+  );
+}
diff --git a/test/pages/listening/playback_test.dart b/test/pages/listening/playback_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..8392a148a9de3a54896e0ce45adbc3574705f0c8
--- /dev/null
+++ b/test/pages/listening/playback_test.dart
@@ -0,0 +1,65 @@
+import 'package:PiliPlus/pages/listening/controller.dart';
+import 'package:PiliPlus/pages/listening/models.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class RetryController extends ListeningController {
+  final calls = <String>[];
+  @override
+  Future<void> save() async {}
+  @override
+  Future<void> openSong(
+    ListeningPlaylist list,
+    ListeningSong song,
+    int request,
+  ) async {
+    calls.add(song.id);
+    if (song.id == 'old' || calls.length < 3 && song.id == 'retry') {
+      throw StateError('temporary stream failure');
+    }
+  }
+}
+
+ListeningSong song(String id) => ListeningSong(
+  id: id,
+  name: id,
+  original: const SongSource(
+    bvid: 'BV1',
+    aid: 1,
+    cid: 1,
+    page: 1,
+    title: 'song',
+  ),
+);
+
+void main() {
+  test('refreshes stream twice before asking to change source', () async {
+    final controller = RetryController();
+    final item = song('retry');
+    final list = ListeningPlaylist(id: 'list', name: 'list', songs: [item]);
+    var failures = 0;
+    controller.onUnavailable = (_) => failures++;
+    await controller.play(list, item);
+    expect(controller.calls, ['retry', 'retry', 'retry']);
+    expect(item.error, isNull);
+    expect(failures, 0);
+    expect(controller.loading.value, isFalse);
+  });
+
+  test('changing song cancels pending retry of old song', () async {
+    final controller = RetryController();
+    final old = song('old');
+    final next = song('next');
+    final list = ListeningPlaylist(
+      id: 'list',
+      name: 'list',
+      songs: [old, next],
+    );
+    final pending = controller.play(list, old);
+    await Future<void>.delayed(const Duration(milliseconds: 20));
+    await controller.play(list, next);
+    await pending;
+    expect(controller.calls, ['old', 'next']);
+    expect(controller.current.value, same(next));
+    expect(controller.loading.value, isFalse);
+  });
+}
