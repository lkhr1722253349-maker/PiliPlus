+            /* Retry metadata later; playback remains available. */
+          }
+        }
+      }
+    } finally {
+      _naming = false;
+      if (_namingPending) {
+        _namingPending = false;
+        unawaited(refreshSongNames());
+      } else {
+        unawaited(translateSongNames());
+      }
+    }
+  }
+
+  String? _openError;
+
+  ListeningPlaylist get selected =>
