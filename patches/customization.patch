+
+  Future<bool> applySearchSongName(
+    ListeningSong song,
+    String sourceKey,
+    SongNameConsensus consensus,
+  ) async {
+    if (song.nameEdited ||
+        song.source.key != sourceKey ||
+        !playlists.any((list) => list.songs.contains(song)))
+      return false;
+    if (song.name == consensus.name) return true;
